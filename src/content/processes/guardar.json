    {
      "id": "descongelar-para-manana",
      "name": "Descongelar la proteína de mañana",
      "category": "guardar",
      "zone": "refri",
      "frequencyDays": null,
      "frequencyLabel": "Todos los días, la noche anterior",
      "estimatedMinutes": null,
      "active": true,
      "source": "Kitchen Manual v0, sección 5",
      "steps": [
        {
          "id": "paso-1",
          "text": "La noche anterior, pasar la proteína de mañana del congelador al refri",
          "minutes": null
        },
        {
          "id": "paso-2",
          "text": "Ponerla en la bandeja de descongelar, en la repisa de abajo, siempre debajo de la comida lista para comer",
          "minutes": null
        },
        {
          "id": "paso-3",
          "text": "Nunca descongelar sobre la encimera, la mesa o el fregadero a temperatura ambiente",
          "minutes": null
        },
        {
          "id": "paso-4",
          "text": "Ya descongelada: el pollo y la carne molida se cocinan en 1 o 2 días; la res y el cerdo en trozos, en 3 días como máximo; las marinadas con limón, el mismo día; la marinada Hawaiian, dentro de 24 horas",
          "minutes": null
        }
      ],
